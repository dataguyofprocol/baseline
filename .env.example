# Baseline server settings for `docker compose`. Copy to .env and fill in.
# Lines left commented keep the image's default.

# ---------- Address and sign-in (required) ----------
# The address people open. Requests addressed to any other host, and writes from any other
# origin, are refused. With compose.https.yaml this is https://<BASELINE_DOMAIN>.
BASELINE_PUBLIC_URL=http://localhost:7770

# Google sign-in: an OAuth client of type "Web application" in Google Cloud, with the authorised
# redirect URI <BASELINE_PUBLIC_URL>/auth/google/callback. Setting GOOGLE_CLIENT_ID requires
# GOOGLE_CLIENT_SECRET and BASELINE_PUBLIC_URL too; the server refuses to start with only some.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The first admin. Signing in with this Google account creates them and always keeps them an admin.
BASELINE_OWNER_EMAIL=

# Name of a new workspace (default "Baseline"). Only read when the database is first created.
# BASELINE_WORKSPACE_NAME=Acme

# The image refuses to start without sign-in configured (1). Setting 0 runs with no sign-in at
# all: anyone who can reach the port can act as any user. Only for a trusted, private network.
# BASELINE_REQUIRE_SIGN_IN=1

# ---------- Email (optional) ----------
# For invites. Without SMTP, invites still work: copy the link from Settings > Members.
# SMTP_FROM is required once SMTP_HOST is set. SMTP_PORT defaults to 587; SMTP_SECURE=true forces
# implicit TLS (the default only for port 465, otherwise STARTTLS is negotiated).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Baseline <baseline@example.com>
# SMTP_SECURE=

# ---------- Ports and HTTPS (compose) ----------
# Where the host publishes Baseline's port 7770 (default 7770 on every interface). Behind Caddy,
# set 127.0.0.1:7770 so plain HTTP is reachable only from this machine.
# BASELINE_PUBLISH=7770

# HTTPS with Caddy and Let's Encrypt: uncomment both lines, point the domain's DNS at this machine,
# and set BASELINE_PUBLIC_URL=https://<the domain> above.
# COMPOSE_FILE=compose.yaml:compose.https.yaml
# BASELINE_DOMAIN=baseline.example.com

# ---------- Set by the image; change only if you know why ----------
# BASELINE_DB=/data/baseline.db    the SQLite database, on the /data volume
# BASELINE_HOST=0.0.0.0            the address the server listens on inside the container
# BASELINE_PORT=7770               the port it listens on inside the container
