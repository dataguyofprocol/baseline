{
  "name": "baseline",
  "version": "0.1.0",
  "description": "Local-first issue & project tracker with a Linear-quality UI, plus a CLI surface for agents.",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "baseline": "./bin/baseline.js"
  },
  "files": [
    "bin/",
    "dist/",
    "web/dist/",
    "skills/"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "BASELINE_DB=\"${BASELINE_DB:-$HOME/.baseline/baseline-dev.db}\" BASELINE_PORT=\"${BASELINE_PORT:-7327}\" tsx watch src/server/index.ts",
    "dev:web": "cd web && vite",
    "build": "npm run build:web && tsc -p tsconfig.node.json",
    "build:web": "cd web && vite build",
    "prepack": "npm run build",
    "start": "npm run build && BASELINE_DB=\"${BASELINE_DB:-$HOME/.baseline/baseline-dev.db}\" BASELINE_PORT=\"${BASELINE_PORT:-7327}\" node dist/server/index.js --open",
    "serve": "BASELINE_DB=\"${BASELINE_DB:-$HOME/.baseline/baseline-dev.db}\" BASELINE_PORT=\"${BASELINE_PORT:-7327}\" node dist/server/index.js --open",
    "cli": "BASELINE_DB=\"${BASELINE_DB:-$HOME/.baseline/baseline-dev.db}\" BASELINE_PORT=\"${BASELINE_PORT:-7327}\" tsx src/cli/index.ts",
    "seed": "BASELINE_DB=\"${BASELINE_DB:-$HOME/.baseline/baseline-dev.db}\" tsx src/cli/index.ts seed --reset",
    "docker:dev": "scripts/docker-dev.sh",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.scripts.json && tsc -p web/tsconfig.json --noEmit",
    "test:cli": "bash scripts/test-cli.sh",
    "test:auth": "tsx scripts/test-auth.ts",
    "test:guards": "tsx scripts/test-state-guards.ts",
    "test:route-policy": "tsx scripts/test-route-policy.ts",
    "test:cli-legacy": "tsx scripts/check-cli-legacy.ts",
    "test:ops": "tsx scripts/check-ops-parity.ts && tsx scripts/test-ops.ts",
    "gen:skill": "tsx scripts/check-ops-parity.ts --write",
    "test:mcp": "tsx scripts/test-mcp.ts",
    "test:summaries": "tsx scripts/test-summaries.ts",
    "test:notify": "tsx scripts/test-notifications.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^14.0.0",
    "hono": "^4.7.0",
    "ink": "^7.1.1",
    "marked": "^18.0.11",
    "nodemailer": "^7.0.13",
    "react": "^19.1.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/react-virtual": "^3.13.0",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-link": "^3.0.0",
    "@tiptap/extension-mention": "^3.30.5",
    "@tiptap/extension-placeholder": "^3.0.0",
    "@tiptap/extension-task-item": "^3.0.0",
    "@tiptap/extension-task-list": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@tiptap/suggestion": "^3.30.5",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "dompurify": "^3.4.17",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.510.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "zustand": "^5.0.0"
  }
}
